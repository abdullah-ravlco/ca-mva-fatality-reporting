# Required for the lead_verification (incident analysis) stage.
OPENAI_API_KEY=
# Optional. Default: gpt-4.1-mini (the model must support structured outputs).
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
# Optional. Enables Tavily news search in source_collection (skipped when empty).
TAVILY_API_KEY=
# Optional. How far back to collect, in hours. Default: 240 (10 days).
LOOKBACK_HOURS=
# JEV (TypeSafe System One) for severity screening. Only the key is required; the URL defaults to
# https://api.typesafe.ai/v1 and the model to jev-latest.
JEV_API_KEY=
JEV_API_URL=
JEV_MODEL=
# Optional: seconds to wait per call (120), retries after the first attempt (4), 0 to stop sending the
# long-context header (1), the confidence below which an answer counts as "not reported" (0.6), and a
# cap on article text sent per incident (0 = full text).
JEV_TIMEOUT_SECONDS=
JEV_MAX_RETRIES=
JEV_LONG_CONTEXT=
JEV_MIN_CONFIDENCE=
JEV_MAX_INPUT_CHARS=
# SearchBug Enhanced People Search (contact enrichment): account number and API key.
SEARCHBUG_CO_CODE=
SEARCHBUG_API_KEY=
# Optional: endpoint (default https://data.searchbug.com/api/search.aspx), timeout (60), retries (3),
# candidates per search (25), paid lookups per run (100), next of kin per deceased person (2).
SEARCHBUG_API_URL=
SEARCHBUG_TIMEOUT_SECONDS=
SEARCHBUG_MAX_RETRIES=
SEARCHBUG_RESULT_LIMIT=
SEARCHBUG_MAX_LOOKUPS_PER_RUN=
SEARCHBUG_MAX_RELATIVES=
# Optional: phones listed per person, most recent first (2).
SEARCHBUG_MAX_PHONES=

# Postgres (optional). The JSON files under data/ are always written; with a database configured the
# results are also stored in Postgres tables (and every JSON output is copied to a documents table).
# Any Postgres server or tool works. Either one URL (local, Docker, Supabase, Neon, RDS, Render...):
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# ...or the standard Postgres variables instead of the URL (as psql / pgAdmin use them):
# PGHOST=  PGPORT=5432  PGDATABASE=  PGUSER=  PGPASSWORD=  PGSSLMODE=require
# Optional: connect timeout in seconds (default 10). The tables go in the "public" schema; add
# DB_SCHEMA=<name> only if they must live in a separate schema.
DB_CONNECT_TIMEOUT=
