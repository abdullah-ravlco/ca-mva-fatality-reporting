# Required for the lead_verification (incident analysis) stage.
OPENAI_API_KEY=
# Optional. Default: gpt-4.1-mini (the model must support structured outputs).
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
# Optional. Enables Tavily news search in source_collection (skipped when empty).
TAVILY_API_KEY=
# Optional. How far back to collect, in hours. Default: 168 (7 days).
LOOKBACK_HOURS=
# Optional. Collect a fixed period instead (both days included); set both or neither.
COLLECT_FROM=
COLLECT_TO=
